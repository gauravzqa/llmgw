# Copy this file to a credential file outside the repository and set
# LLMGW_ENV_FILE to its path. Never commit the copy or replace these values
# with real credentials here.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=

# Deploy arithmetic. The gateway refuses to start when BUDGET_TOTAL exceeds
# DRAIN_GRACE: a total above the grace is a stream the next deploy will cut.
# Keep the orchestrator's kill timeout (Fly `kill_timeout`, k8s
# `terminationGracePeriodSeconds`) ABOVE the grace; that cannot be checked here.
#   LLMGW_BUDGET_TOTAL     <=  LLMGW_DRAIN_GRACE  <  kill timeout
LLMGW_BUDGET_TOTAL=120
LLMGW_DRAIN_GRACE=130
# Set to 1 to start anyway with a WARNING (the bench does; production should not).
LLMGW_DRAIN_ALLOW_SHORT=0

# Per-process stream cap: the (N+1)th concurrent request is a 503 `overloaded`
# with Retry-After: 1, before the body is read. 0 = no cap. Default 150: the
# largest cap at which the S2 load run shed BEFORE it degraded on a 16-core
# laptop (cap 300 still pinned CPU and produced 504s). It is a stream count
# standing in for events/s, so re-derive it per deployment with
# `python -m bench.load --scenario S2` and BENCH_GW_MAX_STREAMS; a Fly
# shared-cpu-1x needs a lower number.
LLMGW_MAX_STREAMS=150

# --- Tenants ---------------------------------------------------------------
# Path to the tenants file (ids and limits; see config/tenants.example.toml).
# Unset = the zero-config path: one anonymous tenant, bearer tokens ignored.
LLMGW_TENANTS_FILE=
# Set to 1 in production: refuse to start without a tenants file, or with one
# whose only tenant is `anonymous`. Default 0 so `make run` + curl still works.
LLMGW_REQUIRE_TENANTS=0
# Tenant tokens are NOT in the tenants file. Each tenant names an environment
# variable with `token_env`; its value is the bearer token. The example file
# names this one. Generate with `openssl rand -hex 32`; set via `fly secrets`.
LLMGW_TENANT_LAYRS_TOKEN=replace-with-a-random-token

# --- PLAN-2 Phase B --------------------------------------------------------
# Status-line wait per attempt (B6). Distinct from LLMGW_BUDGET_CONNECT, which
# is TCP+TLS only. Must stay below LLMGW_BUDGET_FIRST_EVENT.
LLMGW_BUDGET_HEADERS=10
# Per-surface byte caps (B4). Two underscores, then the surface name upper-
# cased. Shipped defaults: openai_chat 32 MiB / 8 MiB, anthropic_messages
# 32 MiB / 8 MiB. An explicitly set LLMGW_MAX_REQUEST_BYTES replaces every
# table default that is not itself overridden per surface.
# LLMGW_MAX_REQUEST_BYTES__ANTHROPIC_MESSAGES=33554432
# LLMGW_MAX_RESPONSE_BYTES__OPENAI_CHAT=8388608
